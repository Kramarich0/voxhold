{
  "mode": "strict",
  "threshold": 5,
  "reporters": ["console"],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/*.d.ts",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/routeTree.gen.ts",
    "**/src/shared/ui/icons/**",
    "**/src/shared/ui/visuals/**",
    "**/src/shared/ui/core/**",
    "**/messages/*.json"
  ],
  "format": ["typescript", "tsx", "javascript"],
  "pattern": "**/*.{ts,tsx,js,jsx}"
}
